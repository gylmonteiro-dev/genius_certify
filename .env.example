# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
# development = Swagger em /api/docs; production = docs desligados
ENVIRONMENT=development

# VPS / Caddy em proxy/ (Let's Encrypt). DNS A/AAAA de DOMAIN deve apontar para a VPS.
DOMAIN=certify.nexusgenius.com.br
ACME_EMAIL=admin@nexusgenius.com.br

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=nexus
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=nexus_certify

# Host `db` = nome do serviço no docker-compose (não use localhost dentro dos containers).
# O Postgres não publica porta no host; acesse só via container/rede Docker.
DATABASE_URL=postgresql+asyncpg://nexus:changeme_postgres@db:5432/nexus_certify

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=changeme_jwt_secret_use_a_long_random_string
JWT_EXPIRE_MINUTES=1440
SUPERADMIN_EMAIL=admin@nexusgenius.com.br
SUPERADMIN_PASSWORD=changeme_superadmin
SUPERADMIN_NOME=Super Admin

# ---------------------------------------------------------------------------
# MinIO / S3
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio
S3_ENDPOINT_URL=http://minio:9000
# Dev (override local): http://localhost:9000
# Prod (Caddy em proxy/ /files → MinIO): https://certify.nexusgenius.com.br/files
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=nexus-certify
S3_REGION=us-east-1
