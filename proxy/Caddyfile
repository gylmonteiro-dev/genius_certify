# Proxy compartilhado da VPS (rede Docker `edge`).
# Novo host: outro bloco aqui + o container do app na mesma rede.
# reverse_proxy usa container_name (visível entre stacks Compose).

{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /files/* {
		uri strip_prefix /files
		reverse_proxy nexus_minio:9000
	}

	handle {
		reverse_proxy nexus_frontend:80
	}
}
